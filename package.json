{
  "name": "nizkhata",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NizKhata — Firestore Security Rules, rules tests and the static landing page. The product is the native Android app (mobile/).",
  "scripts": {
    "emulators": "firebase emulators:start",
    "deploy": "firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:rules:watch": "vitest --config vitest.rules.config.ts"
  },
  "dependencies": {
    "firebase": "^10.12.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "vitest": "^1.6.0"
  }
}
