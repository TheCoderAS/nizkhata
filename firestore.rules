rules_version = '2';

// =============================================================================
// Shared Accounting App — Firestore Security Rules
//
// This file follows §4 of the build spec but TIGHTENS two security holes that
// exist in the spec's draft rules. Both deviations are called out below so they
// can be reviewed:
//
//   [FIX 1] Membership self-create privilege escalation.
//     Spec draft: `allow create if request.resource.data.uid == auth.uid`
//     — that lets ANY signed-in user mint a membership in ANY workspace with
//     ANY roleId (e.g. assign themselves the Owner role of someone else's
//     book). We instead require either (a) the caller can `members.invite`,
//     (b) the caller is the workspace owner bootstrapping their own workspace,
//     or (c) a matching *pending* invite exists for the caller's email whose
//     roleId equals the membership being created. To make (c) checkable inside
//     rules (which can only `get` a known doc id, not query), invite doc IDs
//     are DETERMINISTIC: `${workspaceId}_${lowercased-email}` (see §onboarding
//     in the client). This is a data-model deviation from the spec's random
//     invite id and should be confirmed.
//
//   [FIX 2] Bootstrap chicken-and-egg.
//     Seeding the 4 system roles + owner membership + default categories on
//     first login requires `roles.manage` / `members.invite` perms that don't
//     exist yet. We allow the workspace OWNER to seed roles/memberships/
//     categories directly (isOwner bypass). The client MUST create the
//     `workspaces/{ws}` doc as its own committed write FIRST, then seed in a
//     batch, so `get(workspace).ownerId` resolves during the seed writes.
//
// Not enforceable in rules (enforced in app logic, see §3 guardrails):
//   - cannot delete a role still assigned to a membership
//   - cannot remove the last holder of roles.manage / members.remove
//   - totalAmount == signed sum of lines (rules can't sum arrays cheaply)
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function mId(ws) { return ws + '_' + request.auth.uid; }

    function membership(ws) {
      return get(/databases/$(database)/documents/memberships/$(mId(ws)));
    }

    function isMember(ws) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/memberships/$(mId(ws)));
    }

    function roleOf(ws) {
      return get(/databases/$(database)/documents/roles/$(membership(ws).data.roleId));
    }

    function can(ws, perm) {
      return isMember(ws) && roleOf(ws).data.permissions[perm] == true;
    }

    function workspaceDoc(ws) {
      return get(/databases/$(database)/documents/workspaces/$(ws));
    }

    function isOwner(ws) {
      return isSignedIn() && workspaceDoc(ws).data.ownerId == request.auth.uid;
    }

    function exWs() { return resource.data.workspaceId; }
    function inWs() { return request.resource.data.workspaceId; }

    // workspaceId must never change on update.
    function wsImmutable() {
      return request.resource.data.workspaceId == resource.data.workspaceId;
    }

    function authEmail() {
      return request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    // The reserved Owner role: the seeded system role named "Owner". It may only
    // belong to the workspace owner, so there is exactly one owner at all times.
    function roleDoc(roleId) {
      return get(/databases/$(database)/documents/roles/$(roleId));
    }
    function isOwnerRole(roleId) {
      let r = roleDoc(roleId);
      return r.data.isSystem == true && r.data.name == 'Owner';
    }
    // A membership may carry the Owner role only if its uid is the workspace owner.
    function ownerRoleOnlyForOwner(ws, uid, roleId) {
      return !isOwnerRole(roleId) || uid == workspaceDoc(ws).data.ownerId;
    }

    // [FIX 1] deterministic invite doc for the current caller in a workspace.
    function inviteDoc(ws) {
      return get(/databases/$(database)/documents/invites/$(ws + '_' + authEmail()));
    }
    function hasPendingInvite(ws, roleId) {
      return authEmail() != '' &&
        exists(/databases/$(database)/documents/invites/$(ws + '_' + authEmail())) &&
        inviteDoc(ws).data.status == 'pending' &&
        inviteDoc(ws).data.roleId == roleId;
    }

    // ---- users -------------------------------------------------------------
    match /users/{uid} {
      allow read, create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- workspaces --------------------------------------------------------
    match /workspaces/{ws} {
      allow read:   if isMember(ws);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == ws;
      allow update: if can(ws, 'workspace.edit')
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(ws) && can(ws, 'workspace.delete');
    }

    // ---- memberships -------------------------------------------------------
    match /memberships/{id} {
      // Any member of the workspace may list its members (needed for member
      // pickers, e.g. shared-expense splits); admins keep the same access.
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isMember(resource.data.workspaceId) ||
        can(resource.data.workspaceId, 'members.view')
      );

      // [FIX 1] no open self-join. Only invited users, inviters, or the owner.
      // The Owner role can only be held by the workspace owner.
      allow create: if isSignedIn()
        && request.resource.data.id == id
        && id == request.resource.data.workspaceId + '_' + request.resource.data.uid
        && ownerRoleOnlyForOwner(inWs(), request.resource.data.uid, request.resource.data.roleId)
        && (
          can(inWs(), 'members.invite') ||
          isOwner(inWs()) ||
          (
            request.resource.data.uid == request.auth.uid &&
            hasPendingInvite(inWs(), request.resource.data.roleId)
          )
        );

      // role changes: must keep workspace; cannot change the owner's membership;
      // cannot hand the Owner role to anyone but the owner.
      // Additionally, any member may set/clear ONLY the linkedContactId on
      // their own membership (email auto-link to "their" contact).
      allow update: if (
          can(exWs(), 'members.invite')
          && wsImmutable()
          && resource.data.uid != workspaceDoc(exWs()).data.ownerId
          && ownerRoleOnlyForOwner(exWs(), request.resource.data.uid, request.resource.data.roleId)
        ) || (
          isSignedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedContactId'])
        );

      // A member can leave on their own; an admin can remove others. The owner
      // can neither be removed nor leave (ownership must transfer/delete first)
      // — EXCEPT when the workspace itself has already been deleted, which is
      // how deleting a workspace cleans up the owner's own membership. Once the
      // workspace doc is gone, the owner may delete their dangling membership.
      allow delete: if !exists(/databases/$(database)/documents/workspaces/$(exWs()))
        ? resource.data.uid == request.auth.uid
        : (
            resource.data.uid != workspaceDoc(exWs()).data.ownerId
            && (
              resource.data.uid == request.auth.uid ||
              can(exWs(), 'members.remove')
            )
          );
    }

    // ---- roles -------------------------------------------------------------
    match /roles/{id} {
      allow read:   if isMember(exWs());
      // [FIX 2] owner bypass for first-login seeding.
      allow create: if (can(inWs(), 'roles.manage') || isOwner(inWs()))
        && request.resource.data.id == id;
      allow update: if can(exWs(), 'roles.manage') && wsImmutable();
      allow delete: if can(exWs(), 'roles.manage') && resource.data.isSystem == false;
    }

    // ---- invites -----------------------------------------------------------
    match /invites/{id} {
      allow read: if can(exWs(), 'members.view')
        || (isSignedIn() && resource.data.email == authEmail());
      allow create: if can(inWs(), 'members.invite')
        && request.resource.data.id == id;
      // an inviter can manage; the invitee may flip their own invite to accepted.
      allow update: if (can(exWs(), 'members.invite') && wsImmutable())
        || (
          isSignedIn()
          && resource.data.email == authEmail()
          && request.resource.data.status == 'accepted'
          && wsImmutable()
          && request.resource.data.roleId == resource.data.roleId
        );
      allow delete: if can(exWs(), 'members.invite');
    }

    // ---- generic workspace-scoped collections ------------------------------
    match /accounts/{id} {
      allow read:           if can(exWs(), 'accounts.view');
      allow create:         if can(inWs(), 'accounts.manage');
      allow update:         if can(exWs(), 'accounts.manage') && wsImmutable();
      allow delete:         if can(exWs(), 'accounts.manage');
    }

    match /categories/{id} {
      allow read:           if can(exWs(), 'categories.view');
      // [FIX 2] owner bypass for first-login seeding of default categories.
      allow create:         if can(inWs(), 'categories.manage') || isOwner(inWs());
      allow update:         if can(exWs(), 'categories.manage') && wsImmutable();
      allow delete:         if can(exWs(), 'categories.manage')
                              && resource.data.isSystem == false;
    }

    match /contacts/{id} {
      allow read:           if can(exWs(), 'contacts.view');
      allow create:         if can(inWs(), 'contacts.manage');
      allow update:         if can(exWs(), 'contacts.manage') && wsImmutable();
      allow delete:         if can(exWs(), 'contacts.manage');
    }

    // Budgets: gated by category permissions (no new permission key in v2).
    match /budgets/{id} {
      allow read:           if can(exWs(), 'categories.view');
      allow create:         if can(inWs(), 'categories.manage');
      allow update:         if can(exWs(), 'categories.manage') && wsImmutable();
      allow delete:         if can(exWs(), 'categories.manage');
    }

    // ---- shared ledger (cross-user, NOT workspace-scoped) ------------------
    // Splitwise-style sharing between two real app users across their separate
    // workspaces. These docs are gated purely by "are you one of the two
    // parties" — never by workspace membership/permissions — and carry only
    // denormalized display data, so no book internals leak between users.

    function isParty() { return isSignedIn() && request.auth.uid in resource.data.uids; }
    function willBeParty() { return isSignedIn() && request.auth.uid in request.resource.data.uids; }

    // A standing relationship between two users. doc id = sorted uid pair.
    match /sharedConnections/{id} {
      allow read:   if isParty();
      allow create: if willBeParty()
        && request.resource.data.id == id
        && request.resource.data.uids.size() == 2;
      // Either party may refresh denormalized names/emails, but never change
      // the membership of the pair.
      allow update: if isParty() && willBeParty()
        && request.resource.data.uids == resource.data.uids;
      allow delete: if isParty();
    }

    // A one-sided "let's share" request addressed by email. doc id is
    // deterministic (`${fromUid}_${lowercased-email}`) so the invitee — who may
    // not exist as a uid yet — can be matched, mirroring workspace invites.
    match /shareInvites/{id} {
      allow read: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toEmail == authEmail()
      );
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.id == id
        && id == request.resource.data.fromUid + '_' + request.resource.data.toEmail;
      // The inviter can revoke; the invitee may flip only the status to accepted.
      allow update: if isSignedIn() && (
        (resource.data.fromUid == request.auth.uid
          && request.resource.data.fromUid == resource.data.fromUid)
        || (
          resource.data.toEmail == authEmail()
          && request.resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );
      allow delete: if isSignedIn() && resource.data.fromUid == request.auth.uid;
    }

    // A single bilateral shared item (expense or settlement). The creator owns
    // the immutable facts; the counterparty owns only their consent.
    match /sharedEntries/{id} {
      allow read: if isParty();
      allow create: if willBeParty()
        && request.resource.data.id == id
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.uids.size() == 2
        && request.resource.data.counterpartyUid in request.resource.data.uids
        && createdUid(request.resource.data) == request.auth.uid;
      // Update is tightly scoped by WHO you are:
      //   - the counterparty may change ONLY their consent (status + the
      //     mirrored pendingForUids), never amount/shares/parties;
      //   - the creator may change ONLY `resolved` (clearing a conflict).
      // Everything else is immutable post-create.
      allow update: if isSignedIn() && (
        (
          resource.data.counterpartyUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'pendingForUids', 'updatedBy', 'updatedAt'])
        ) || (
          resource.data.creatorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['resolved', 'updatedBy', 'updatedAt'])
        )
      );
      // Only the creator can withdraw the claim entirely.
      allow delete: if isSignedIn() && resource.data.creatorUid == request.auth.uid;
    }

    match /debts/{id} {
      allow read:           if can(exWs(), 'debts.view');
      allow create:         if can(inWs(), 'debts.manage');
      allow update:         if can(exWs(), 'debts.manage') && wsImmutable();
      allow delete:         if can(exWs(), 'debts.manage');
    }

    match /dues/{id} {
      allow read:           if can(exWs(), 'dues.view');
      allow create:         if can(inWs(), 'dues.manage');
      allow update:         if can(exWs(), 'dues.manage') && wsImmutable();
      allow delete:         if can(exWs(), 'dues.manage');
    }

    // ---- transactions ------------------------------------------------------
    // createdBy is a denormalized actor object { uid, name }. Legacy docs may
    // still store a bare uid string, so accept both shapes for comparisons.
    function createdUid(data) {
      return data.createdBy is map ? data.createdBy.uid : data.createdBy;
    }
    match /transactions/{id} {
      allow read:   if can(exWs(), 'transactions.view');
      allow create: if can(inWs(), 'transactions.create')
        && createdUid(request.resource.data) == request.auth.uid;
      allow update: if can(exWs(), 'transactions.edit')
        && wsImmutable()
        && createdUid(request.resource.data) == createdUid(resource.data);
      allow delete: if can(exWs(), 'transactions.delete');
    }

    // ---- revisions (append-only audit log) ---------------------------------
    // Any workspace member can read the history and append entries; nobody can
    // edit or delete them. The author must stamp themselves as `by.uid`.
    // (Client-authored today; a Cloud Function can take over later unchanged.)
    match /revisions/{id} {
      allow read:   if isMember(exWs());
      allow create: if isMember(inWs())
        && request.resource.data.by.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
