<?xml version="1.0" encoding="utf-8"?>
<!-- The app's near-black canvas, lifted slightly at the top so the panel has
     depth instead of reading as one flat navy rectangle. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#13161D"
        android:endColor="#0A0B0F" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#262B34" />
</shape>
