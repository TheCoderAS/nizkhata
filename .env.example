# Firebase web app config. Copy to `.env` and fill in from your Firebase project
# (Project settings -> Your apps -> SDK setup and configuration).
# All Vite client env vars must be prefixed with VITE_.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — enables Google Analytics in production builds only.
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "true" to connect to the local Firebase Emulator Suite instead of prod.
VITE_USE_EMULATORS=true
